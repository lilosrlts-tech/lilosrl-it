# Supabase (sito pubblico)
# Dashboard → Project Settings → API Keys
# Se sb_publishable_... dà "Invalid API key", usa la chiave legacy anon (inizia con eyJhbGci...)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Solo server (API preventivo / admin scripts) — non esporre al browser
SUPABASE_SERVICE_ROLE_KEY=
# true = dati demo locali | false = legge da Supabase
NEXT_PUBLIC_DEMO_MODE=false

# =============================================================================
# Email preventivo (Resend)
# =============================================================================
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=
# Mittente verificato sul dominio (dopo DKIM/SPF/MX in DNS)
# es. LILO S.r.l. <noreply@lilosrl.it>
RESEND_FROM_EMAIL=

# =============================================================================
# Google — Search Console, Tag unificato, Analytics, Ads
# =============================================================================

# Verifica proprietà Google Search Console (meta google-site-verification)
GOOGLE_SITE_VERIFICATION=

# Google tag unificato (GT-…) + GA4 + Ads — dominio www.lilosrl.it
NEXT_PUBLIC_GOOGLE_TAG_ID=GT-MRQFTWP9
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-H1NS1CSJ0B
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-966829199

# Solo se usi un contenitore GTM classico (GTM-…). Lascia vuoto con GT-.
NEXT_PUBLIC_GTM_ID=

# Label conversioni Ads (opzionale — da Ads → Conversioni, dopo aver creato l’azione)
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_PHONE_CSS_CLASS=google-phone
NEXT_PUBLIC_GOOGLE_PHONE_CONVERSION_NUMBER=+390402471720

# =============================================================================
# GDPR — Cookie consent
# =============================================================================
# Opzione A (consigliata se già usate Iubenda su autolavaggiolilo.it):
# Dashboard Iubenda → Embed → Site ID + Cookie Policy ID per lilosrl.it
NEXT_PUBLIC_IUBENDA_SITE_ID=
NEXT_PUBLIC_IUBENDA_COOKIE_POLICY_ID=
# Opzione B: Cookiebot
NEXT_PUBLIC_COOKIEBOT_ID=
# =============================================================================
# Gestionale PHP — proxy /.gestionale/* → hosting Aruba gestionalelilo.it
# =============================================================================
# Configurato in web/vercel.json → https://www.gestionalelilo.it/.gestionale/*
