# Supabase
# Se sb_publishable_/sb_secret_ dà "Invalid API key", usa le chiavi Legacy (iniziano con eyJhbGci...)
# Dashboard → Project Settings → API Keys → Legacy → anon (web) e service_role (admin)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bucket Storage Supabase (default: veicoli)
SUPABASE_STORAGE_BUCKET=veicoli

# Protezione pannello admin (password per il login)
ADMIN_PASSWORD=change-me-in-production

# Segreto per firmare il cookie di sessione (min. 32 caratteri)
ADMIN_SESSION_SECRET=genera-una-stringa-casuale-lunga-almeno-32-caratteri
